# ============================================================
#  Backend (api-yuuna) — ตัวอย่าง env
#  วิธีใช้: cp .env.example .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ
#  หมายเหตุ: ไฟล์ .env จริงเป็น gitignored ห้าม commit secret
# ============================================================

# ===== Server =====
PORT=8080
# บังคับ bind เฉพาะ loopback — ค่าอื่น (เช่น 0.0.0.0) จะถูกบังคับกลับเป็น 127.0.0.1
HOST=127.0.0.1

# ===== Frontend / CORS =====
# origin ของ frontend (ถูกเพิ่มเข้าไปในรายการ CORS ที่อนุญาตอัตโนมัติ)
FRONTEND_URL=http://localhost:5173
# (ทางเลือก) รายการ origin ที่อนุญาต คั่นด้วย , — ถ้าไม่ตั้งจะใช้ค่า default:
# https://yuuna.tcmg.me และ http://localhost:3000
ALLOWED_ORIGINS=https://yuuna.tcmg.me,http://localhost:3000

# ===== Database (PostgreSQL) =====
DATABASE_URL=host=localhost user=postgres password=postgres dbname=yuna_db port=5433 sslmode=disable

# ===== Redis =====
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ===== AI (Google Gemini) =====
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# ===== Auth (จำเป็น — เซิร์ฟเวอร์จะ fail-fast ถ้าขาด) =====
# สุ่มค่าใหม่ด้วย: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-32-byte-hex-string
# Google OAuth Client ID (ชนิด Web application) — ต้องตรงกับ VITE_GOOGLE_CLIENT_ID ฝั่ง frontend
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ===== Trusted Proxies (ทางเลือก) — default: 127.0.0.1,::1 =====
TRUSTED_PROXIES=127.0.0.1,::1
