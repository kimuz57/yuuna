# ============================================================
#  Frontend (yuuna) — ตัวอย่าง env
#  วิธีใช้: cp .env.example .env (หรือ .env.production ก่อน build)
#  หมายเหตุ: ค่าถูกฝังตอน build — แก้แล้วต้อง npm run build ใหม่
# ============================================================

# Google OAuth Client ID (ชนิด Web application)
# ต้องตรงกับ GOOGLE_CLIENT_ID ฝั่ง backend เป๊ะ ๆ
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ไม่ต้องตั้ง VITE_BACKEND_URL:
# ฝั่ง frontend เรียก API ด้วย relative path /api/... ทุกจุด
# - Development: Vite dev proxy (vite.config.js) ส่ง /api -> http://127.0.0.1:8080
# - Production: reverse proxy (เช่น Caddy/Nginx) บนโดเมนเดียวกัน route /api -> 127.0.0.1:8080
